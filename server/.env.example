# OmniCall SFU Server — Environment Variables Configuration

PORT=4000
JWT_SECRET=your_strong_jwt_secret_here
CLIENT_ORIGIN=http://localhost:5173

# LiveKit Cloud Credentials (https://cloud.livekit.io)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# Cloud PostgreSQL Database (Neon / Supabase / Render Postgres)
# Leave empty for local SQLite fallback (data.sqlite)
# Neon: Use pooled connection string (ep-xyz-pooler.neon.tech)
# Supabase: Add ?pgbouncer=true for transaction mode pooling
# DATABASE_URL=postgresql://user:pass@ep-xyz-pooler.eastus2.azure.neon.tech/neondb?sslmode=require
DATABASE_PATH=./data.sqlite
PG_POOL_MAX=10
# PG_SSL_CA=-----BEGIN CERTIFICATE-----\n...-----END CERTIFICATE-----

# Cloudflare R2 Object Storage (10GB Free Tier, Zero Egress Fees)
# Leave empty for local disk storage fallback (./uploads)
# All 4 keys are required for R2 mode. If any key is missing, boot fails fast.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=omnicall-media
# R2_PUBLIC_DOMAIN=media.yourdomain.com

# Admin Account
ADMIN_EMAIL=admin@omnicall.com
ADMIN_PASSWORD=adminomnicall@12

# File Storage Directories (Local fallback mode)
UPLOADS_DIR=./uploads
PROCESSED_DIR=./processed
